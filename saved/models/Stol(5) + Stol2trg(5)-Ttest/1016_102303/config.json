{
    "name": "Stol(5) + Stol2trg(5)-Ttest",
    "n_gpu": 1,
    "arch": {
        "type": "AAmodel",
        "args": {
            "in_channels": 1,
            "num_classes": 2,
            "img_num": 5
        }
    },
    "data_loader": {
        "type": "DA_70028_DataLoader",
        "args": {
            "data_dir": [
                "/home/lwy/70028-Stol-target-dataset",
                "/home/lwy/Stol2trg"
            ],
            "batch_size": 64,
            "shuffle": true,
            "num_workers": 8,
            "img_num": 5
        }
    },
    "valid_data_loader": {
        "type": "DA_70028_DataLoader",
        "args": {
            "data_dir": "/home/lwy/724-70028/XY/test-DA",
            "batch_size": 64,
            "shuffle": true,
            "num_workers": 8,
            "img_num": 5
        }
    },
    "optimizer": {
        "type": "Adam",
        "args": {
            "lr": 0.001,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": "mse_loss_means",
    "metrics": [
        "mae_xs",
        "mae_ys"
    ],
    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 10,
            "gamma": 0.1
        }
    },
    "trainer": {
        "epochs": 200,
        "save_dir": "saved/",
        "save_period": 1,
        "verbosity": 2,
        "monitor": "min val_loss",
        "early_stop": 30,
        "tensorboard": true
    }
}