{
    "name": "70028So-Stol-LHS-GI",
    "n_gpu": 1,
    "arch": {
        "type": "AAmodel",
        "args": {
            "in_channels": 1,
            "num_classes": 4, 
            "img_num": 5
        }
    },
    "data_loader": {
        "type": "GI_70028_DataLoader",
        "args": {
            "data_dir": [
                "/home/lwy/70028_sim/70028-So-dataset-XY&UV"
            ],
            "batch_size": 64,
            "shuffle": true,
            "num_workers": 8,
            "img_num": 5,
            "use_gi": false
        }
    },
    "valid_data_loader": {
        "type": "GI_70028_DataLoader",
        "args": {
            "data_dir": [
                "/home/lwy/70028_sim/Stol-Dataset-LHS-Origin"
            ],
            "batch_size": 64,
            "shuffle": false,
            "num_workers": 8,
            "img_num": 5,
            "use_gi": false
        }
    },
    "optimizer": {
        "type": "Adam",
        "args": {
            "lr": 0.001,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": "mse_loss_means",
    "metrics": [
        "mae_xs",
        "mae_ys",
        "mae_xt", 
        "mae_yt"
    ],
    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 10,
            "gamma": 0.1
        }
    },
    "trainer": {
        "epochs": 200,
        "save_dir": "saved/GI4dof",
        "save_period": 1,
        "verbosity": 2,
        "monitor": "min val_loss",
        "early_stop": 30,
        "tensorboard": true
    }
}