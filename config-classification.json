{
    "name": "class-70028So(with ISP)+S2T(paired P2P)+Ttrain(1, step=10um)-Ttest",
    "n_gpu": 1,
    "arch": {
        "type": "AAmodel_classification",
        "args": {
            "in_channels": 1,
            "num_bins": 85,
            "img_num": 5
        }
    },
    "data_loader": {
        "type": "DA_70028_DataLoader_classification",
        "args": {
            "data_dir": ["/home/lwy/70028-So-target-dataset", "/home/lwy/src2trg_P2P", "/home/lwy/724-70028/XY/train-DA"],
            "batch_size": 64,
            "shuffle": true,
            "num_workers": 8,
            "img_num": 5,
            "num_bins": 85
        }
    },
    "valid_data_loader": {
        "type": "DA_70028_DataLoader_classification",
        "args": {
            "data_dir": "/home/lwy/724-70028/XY/test-DA",
            "batch_size": 64,
            "shuffle": true,
            "num_workers": 8,
            "img_num": 5,
            "num_bins": 85
        }
    },
    "optimizer": {
        "type": "Adam",
        "args": {
            "lr": 0.001,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": "cross_entropy_loss",
    "metrics": [
        "accuracy",
        "top_k_acc",
        "mae_x",
        "mae_y"
    ],
    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 10,
            "gamma": 0.1
        }
    },
    "trainer": {
        "epochs": 200,
        "save_dir": "saved/",
        "save_period": 1,
        "verbosity": 2,
        "monitor": "min val_loss",
        "early_stop": 30,
        "tensorboard": true
    }
}